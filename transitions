            size_hint=(1, None),
            height=300          
        )
        layout.add_widget(image)
        
        # Regresar invierte la animación (hacia la izquierda, usamos el valor por defecto)
        btn_volver = Button(text="Regresar", destino="inicio")
        layout.add_widget(btn_volver)
        self.add_widget(layout)

class MiApp(App):
    def build(self):
        pantallas = ScreenManager()
        # Añadimos todas las pantallas al manager
        pantallas.add_widget(PantallaInicio(name="inicio"))
        pantallas.add_widget(PantallaArriba(name="pantalla_arriba"))
        pantallas.add_widget(PantallaAbajo(name="pantalla_abajo"))
        pantallas.add_widget(PantallaIzquierda(name="pantalla_izq"))
        pantallas.add_widget(PantallaDerecha(name="pantalla_der"))
        return pantallas

if __name__ == '__main__':
    MiApp().run()

